# Required for startup. Copy to .env.local; never commit real values.
NEXT_PUBLIC_APP_URL=
# Set BACKEND_URL on Vercel to the Render HTTPS origin. Leave blank on Render.
BACKEND_URL=
MONGODB_URI=
JWT_SECRET=
# Optional. Defaults to 7d.
JWT_EXPIRES_IN=
# Required before enabling the future order-expiry cron route.
CRON_SECRET=

# ImageKit selected by default. Local supplied images work without uploads.
# ENABLE_IMAGE_UPLOADS defaults to false; set true only after adding credentials.
IMAGE_PROVIDER=
ENABLE_IMAGE_UPLOADS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Enable email verification after configuring SMTP. See docs/SMTP_SETUP.md.
# For Gmail, use an app password and the same address for SMTP_USER and EMAIL_FROM.
ENABLE_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
STORE_CONTACT_EMAIL=

# Optional checkout WhatsApp recipient for local development, in international digits.
CHECKOUT_WHATSAPP_TEST_NUMBER=
# Meta WhatsApp Cloud API sender. See docs/WHATSAPP_CHECKOUT.md.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=

# Reserved, inactive merchant integrations. Not used by COD/manual Easypaisa.
JAZZCASH_ENV=
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_API_BASE_URL=
JAZZCASH_RETURN_URL=
EASYPAISA_ENV=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_API_BASE_URL=
EASYPAISA_RETURN_URL=
